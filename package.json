{
    "name": "@thejulianjara/whatsapp.js",
    "version": "1.3.8",
    "description": "A typed WhatsApp Cloud API client for Node.js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "type": "commonjs",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsc",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "docs": "typedoc",
        "docs:md": "typedoc --options typedoc-markdown.json",
        "docs:all": "pnpm run docs && pnpm run docs:md",
        "prepublishOnly": "pnpm run build && pnpm test"
    },
    "keywords": [
        "whatsapp",
        "whatsapp-cloud-api",
        "whatsapp-api",
        "api",
        "client",
        "typescript"
    ],
    "author": "TheJulianJara",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TheJulianJara/whatsapp.js.git"
    },
    "homepage": "https://github.com/TheJulianJara/whatsapp.js#readme",
    "bugs": {
        "url": "https://github.com/TheJulianJara/whatsapp.js/issues"
    },
    "packageManager": "pnpm@10.6.2",
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.14",
        "@typescript-eslint/eslint-plugin": "^8.28.0",
        "@typescript-eslint/parser": "^8.28.0",
        "eslint": "^9.23.0",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.28.0"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}